+	struct ipu_isys_buffer *ib, *next;
+	unsigned long flags;
+
+	if (!aq)
+		return;
+	spin_lock_irqsave(&aq->lock, flags);
+	if (success) {
+		list_splice_tail_init(&aq->ir_start_done, &done);
+		/* Corrupt returns may arrive during the last verification refeed. */
+		list_splice_tail_init(&aq->incoming, &failed);
+	} else {
+		/* start_streaming's return_buffers supplies QUEUED exactly once. */
+		list_splice_tail_init(&aq->ir_start_done, &aq->incoming);
+	}
+	aq->ir_start_pending = false;
+	spin_unlock_irqrestore(&aq->lock, flags);
